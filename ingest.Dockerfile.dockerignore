# ingest.Dockerfile's own build context (BuildKit reads <Dockerfile>.dockerignore instead of .dockerignore): it
# needs dbt/, config/ and contracts/, which the app's image leaves out.
.git
.venv
.claude
build
lake
lake-*
docs
tests
app
eval
marketplace
runbook
dbt/target
dbt/logs
**/__pycache__
**/*.pyc
src/terraform
